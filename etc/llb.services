
# Begin Service
# SERVICE_NAME = <name>
# TYPE         = user | daemon
# IMAGE        = <sif path>
# RUNTIME      = <runtime path>
# COMMAND      = <cmd>              # mandatory, all types
# PORT         = <port>             # mandatory if user, forbidden if daemon
# QUEUE        = <queue>            # optional
# RESTART      = always | on-failure | never
# End Service

Begin Service
SERVICE_NAME = echotest
TYPE         = user
RUNTIME      = /usr/local/bin/apptainer
IMAGE        = /export/service_images/python-slim.sif
COMMAND      = python3 /home/david/lavalite-test/echo_server.py 8888
PORT         = 8888
RESTART      = always
End Service

Begin Service
SERVICE_NAME = jupyter
TYPE         = user
RUNTIME      = /usr/local/bin/apptainer
IMAGE        = /export/service_images/jupyter-base.sif
PORT         = 8888
COMMAND      = jupyter lab --ip=0.0.0.0 --port=8888 --no-browser
RESTART      = always
QUEUE = service-2.0
End Service

Begin Service
SERVICE_NAME = code-server
TYPE         = user
RUNTIME      = /usr/local/bin/apptainer
IMAGE        = /export/service_images/code-server.sif
PORT         = 8080
COMMAND = code-server --bind-addr 0.0.0.0:8080 --auth none
RESTART      = always
QUEUE = service-2.0
End Service

Begin Service
SERVICE_NAME = node-info
TYPE         = daemon
RUNTIME      = /usr/local/bin/apptainer
IMAGE        = /export/service_images/busybox.sif
COMMAND      = sh -c 'while true; do echo "hello from $(hostname) at $(date)"; sleep 30; done'
RESTART      = always
QUEUE = service-2.0
End Service
