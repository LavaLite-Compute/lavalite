#
# LavaLite Queue Configuration
#
# QUEUE_NAME  - Logical name of the queue
# PRIORITY    - Higher values are scheduled first
# HOSTS       - Hosts, host groups, or all for every host in llb.hosts
# USERS       - Users allowed to access the queue
# MAX_JOBS    - Maximum number of running and suspended jobs in the queue;
#               omitted = unlimited, 0 = dispatch nothing
# USER_MAX_CPUS - Maximum CPUs one user's running and suspended jobs hold
#               in the queue, cpus per host x hosts; omitted = unlimited,
#               0 = dispatch nothing
# DESCRIPTION - Human readable description
#

Begin Queue
QUEUE_NAME  =  mycpuqueue
PRIORITY    = 10
HOSTS       =  mycpuhosts
USERS =  myusers
DESCRIPTION = General purpose CPU workloads
End Queue

Begin Queue
QUEUE_NAME  =  myservicequeue
PRIORITY    = 10
HOSTS       =  myservicehosts
USERS =  myusers
DESCRIPTION = Service workloads
End Queue

Begin Queue
QUEUE_NAME  =  mygpuqueue
PRIORITY    = 10
HOSTS       =  mygpuhosts
USERS =  myusers
DESCRIPTION = General purpose GPU workloads
End Queue

